# Application Settings
PROJECT_NAME="Closed-Loop Autonomous Data Incident Agent"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Exasol Database Configuration
EXASOL_HOST=127.0.0.1
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
# EXASOL_SCHEMA=PUBLIC
EXASOL_ENCRYPTION=True
EXASOL_VALIDATE_CERT=False

# Timeouts in seconds
EXASOL_CONNECTION_TIMEOUT=30
EXASOL_SOCKET_TIMEOUT=60

# Operational data and memory
POSTGRES_URL=postgresql+psycopg://incident:mock-postgres-password@localhost:5433/incidents
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=mock-qdrant-key-replace-me
OPENAI_API_KEY=mock-openai-key-replace-me
OPENAI_MODEL=gpt-4o-mini
DATA_ROOT=/Users/admin/Downloads/autonomous_data_incident_platform
LOCAL_STATE_DIR=.local-state
